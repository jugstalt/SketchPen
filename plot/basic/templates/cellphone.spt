path.addarc(180, 90, 10,10, -15,-26);
path.addarc(270, 90, 10,10,  15,-26);
path.addarc(  0, 90, 10,10,  15, 24);
path.addarc( 90, 90, 10,10, -15, 24);
path.close();

path.fill(@@backgroundBrushColor);
