path.begin();

path.addarc(180, 90, 20,20, -18,-35);
path.addarc(270, 90, 20,20,  18,-35);
path.addarc(  0, 90, 20,20,  18, 35);
path.addarc( 90, 90, 20,20, -18, 35);
path.close();

path.fill();
path.draw(@@outlinePenColor);

