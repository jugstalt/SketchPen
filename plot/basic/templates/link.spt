path.begin();
path.addarc(-180, 180, 15, 0, -33);
path.addlines(7.5,-33, 7.5, -18);
path.addarc(0, 180, 15, 0, -18);
path.close();
path.draw();

path.begin();
path.addarc(-180, 180, 15, 0, 18);
path.addlines(7.5, 18, 7.5, 33);
path.addarc(0, 180, 15, 0, 33);
path.close();
path.draw();

pen.width(8);
pen.color("#fff");
line.draw(0, -18, 0, 18);

pen.width(@@penWidth);
