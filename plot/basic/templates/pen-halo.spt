path.begin();
path.addlines(-27,-12, 35,-12);
path.addarc(270,180, 24,24, 35,0);
path.addlines(35,12, -27,12);
path.addlines(-27,12, -49,0, -27,-12);
path.close();

pen.color("#fff")
brush.color("#fff");
gradientbrush.color("#fff");

path.fill();
path.draw();

pen.color(@@penColor);
brush.color(@@brushColor);
gradientbrush.color(@@gradientbrushColor);