path.begin();

//Thumb
path.addarc(90,90, 25,70, -20,10);
path.addarc(180,90, 25,20, -20,10);

// pointer
path.addarc(180,180, 12,12, -14,-40);

// middle, ring, pinky
path.addarc(180,180, 12,12, -2,-10);
path.addarc(180,180, 12,12, 10,-7);
path.addarc(180,180, 12,12, 22,-2);

path.addarc(0,90, 40,40, 5,25);
path.close();

path.fill();
path.draw();