line.draw(-40,0, 40,0);
line.draw(0,-40, 0,40);

path.begin();
path.addlines(0,0, -30,0);
path.addarc(180,90, 60,60, 0,0);
path.close();
path.addlines(0,0, 30,0);
path.addarc(0,90, 60,60, 0,0);
path.close();
path.fill(@@backgroundBrushColor);
path.draw(@@outlinePenColor);

path.begin();
path.addlines(0,0, 0,-30);
path.addarc(270,90, 60,60, 0,0);
path.close();
path.addlines(0,0, 0,30);
path.addarc(90,90, 60,60, 0,0);
path.close();
path.fill();
path.draw(@@outlinePenColor);