brush.color("#fefefe");
gradientbrush.color("#fefefe");

path.begin();
path.addlines(0,0, -30,0);
path.addarc(180,90, 60,60, 0,0);
path.close();
path.addlines(0,0, 30,0);
path.addarc(0,90, 60,60, 0,0);
path.close();
path.fill();
path.draw();

brush.color(@@brushColor);
gradientbrush.color(@@gradientbrushColor);

path.begin();
path.addlines(0,0, 0,-30);
path.addarc(270,90, 60,60, 0,0);
path.close();
path.addlines(0,0, 0,30);
path.addarc(90,90, 60,60, 0,0);
path.close();
path.fill();
path.draw();

line.draw(-35,0, 35,0);
line.draw(0,-35, 0,35);