pen.width(2);

path.begin();
path.addlines(-45,-20, 45,-20, 45,20, -45,20);
path.close();
path.draw("#ccc");

pen.width(@@penWidth);

transform.reset();
transform.translate(-35,-20);
transform.rotate(30);
transform.scale(0.25);
circle.draw(30,20, -30,0);
line.draw(-15,0, 42, 0);

transform.reset();
transform.translate(-35,-20);
transform.rotate(-30);
transform.scale(0.25);
circle.draw(30,20, -30,0);
line.draw(-15,0, 42, 0);