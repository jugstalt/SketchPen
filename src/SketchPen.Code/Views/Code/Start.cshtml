@model SketchPen.Code.Models.Code.IndexModel
@{
    Layout = "~/Views/Shared/_Layout_empty-sketchpen-code-nocode-frame.cshtml";
    ViewBag.Title = "SketchPen Code";
}

<div class="sketchpen-code-tiles">
    <div class="sketchpen-code-tile" onclick="window.open('https://github.com/jugstalt/SketchPen');return false;">
       <h1>Welcome to DataLinq.Code</h1>
       <p>
                The SketchPen Code Editor
       </p>
    </div>

    <div class="sketchpen-code-tile" onclick="downloadPackage();return false;">
        <h1>Download Package</h1>
        <p>
            Download the icons in current style.
        </p>
    </div>
</div>

<div class="sketchpen-code-output">

</div>

@section scripts {
    <script src="~/js/sketchpen-code.js"></script>
    <script src="~/js/sketchpen-code.events.js"></script>
    <script src="~/js/sketchpen-code.ui.tree.js"></script>
    <script src="~/js/sketchpen-code.ui.modal.js"></script>
    <script src="~/js/sketchpen-code.ui.download-package.js"></script>

    <script type="text/javascript">
        $(function () {
            sketchPenCode.start('@Model.CurrentUrl', '@Model.Id');
        });

        function downloadPackage() {
            $('body').sketchPen_code_modal({
                title: 'Download Package',
                onload: function ($content) {
                    $content.sketchPenCode_download_package({});
                }
            });
        }
    </script>
}