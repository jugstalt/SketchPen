@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div id="toolbar" style="position:absolute;left:0px;top:60px;height:30px;right:0px">
    <button onclick="run()">Run</button>
</div>
<div id="spn-editor" style="position:absolute;left:0px;top:90px;bottom:60px;width:600px">

</div>

<div style="position:absolute;left:600px;top:90px;bottom:60px;right:0px">
    <table>
        <tr>
            <td>
                <select id="image-size">
                    <option value="26">26 x 26</option>
                    <option value="64">32 x 32</option>
                    <option value="64">64 x 64</option>
                    <option value="128">128 x 128</option>
                    <option value="256">256 x 256</option>
                    <option value="512" selected>512 x 512</option>
                </select>
            </td>
        </tr>
        <tr>
            <td>
                <img id="result-image" />
            </td>
        </tr>
    </table>
    
</div>

