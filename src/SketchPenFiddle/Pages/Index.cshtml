            console.log('create editor');

            spnEditor = monaco.editor.create(document.getElementById("spn-editor"), {
                value: "",
                language: "javascript"
            });

            $('#image-size').change(function () { run() });
        }
    })();

        function run() {
            var code = spnEditor.getValue();

            $.ajax({
                method: 'post',
                url: '/api/plot/base64?size='+$('#image-size').val(),
                data: code,
                processData: false,
                contentType: 'application/json',
                success: function (result) {
                    $('#result-image').attr('src', 'data:image/png;base64, ' + result);
                }
            })
        }
    </script>
}
